# Copy to .env next to docker-compose.yml (never commit it) and fill in.
# See README.md in this folder.

# Your node's domain. Its DNS A record must point to this server BEFORE the first
# start — Caddy requests the Let's Encrypt certificate for it right away.
NEVOD_DOMAIN=node.example.org

# Admin panel password — required, the node doesn't start without it. Use a long
# random one, e.g. the output of: openssl rand -base64 24
# It stays a permanent emergency login; more admin accounts can be added in the panel.
NEVOD_ADMIN_PASSWORD=

# true (default): the panel is at https://NEVOD_DOMAIN/nevod-admin.
# false: closed to the internet, reachable only through an SSH tunnel:
#   ssh -L 8766:127.0.0.1:8766 user@server   then open http://localhost:8766/nevod-admin
NEVOD_ADMIN_PUBLIC=true

# Only if this node runs its own TURN relay for calls (leave empty otherwise).
TURN_SECRET=
