# Copy to a real .env next to docker-compose.home.yml (NOT committed) and fill in
# the actual values for this machine. See README.md in this folder.

# Absolute host path to this node's existing (or new) data folder — forward
# slashes even on Windows, Docker Desktop expects them this way.
NEVOD_DATA_DIR=C:/Users/YOURNAME/AppData/Roaming/Nevod

# Only used the FIRST time this data folder has no node.json yet (entrypoint.sh
# runs `genesis` in that case). Irrelevant for a folder migrated from an
# already-running node — kept here for documentation/future re-genesis.
NEVOD_ADDRESS=YOUR.PUBLIC.IP:8765

# Address handed to phone clients in invite tokens — usually the domain your
# reverse proxy (Caddy/nginx) serves this node under.
NEVOD_PUBLIC_CLIENT_ADDR=yourdomain.example/nevod-ws

# Web admin panel password (port 8766) — the panel does not start without it.
# It stays a permanent break-glass login; more admin accounts can be added in
# the panel itself.
NEVOD_ADMIN_PASSWORD=

# Only needed if this node runs its own TURN relay for calls.
TURN_SECRET=
