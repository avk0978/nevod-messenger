    "В Nevod встроена дополнительная клавиатура для набора церковнославянского текста историческими буквами (ѡ, ѣ, ѕ, ѳ, ѵ и др.), шрифтом Ponomar Unicode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevod enthält eine integrierte Tastatur zum Schreiben kirchenslawischer Texte mit historischen Buchstaben (ѡ, ѣ, ѕ, ѳ, ѵ usw.) in der Unicode-Schrift Ponomar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevod includes a built-in keyboard for typing Church Slavonic text with historical letters (ѡ, ѣ, ѕ, ѳ, ѵ, etc.), using the Ponomar Unicode font."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevod incluye un teclado integrado para escribir texto en eslavo eclesiástico con letras históricas (ѡ, ѣ, ѕ, ѳ, ѵ, etc.) usando la fuente Unicode Ponomar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevod inclut un clavier intégré pour saisir du texte en slavon d'église avec les lettres historiques (ѡ, ѣ, ѕ, ѳ, ѵ, etc.), grâce à la police Unicode Ponomar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevod include una tastiera integrata per scrivere testi in slavo ecclesiastico con lettere storiche (ѡ, ѣ, ѕ, ѳ, ѵ, ecc.) usando il font Unicode Ponomar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Nevod встроена дополнительная клавиатура для набора церковнославянского текста историческими буквами (ѡ, ѣ, ѕ, ѳ, ѵ и др.), шрифтом Ponomar Unicode."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevod, Ponomar Unicode yazı tipini kullanarak tarihî harflerle (ѡ, ѣ, ѕ, ѳ, ѵ vb.) Kilise Slavcası metin yazmak için yerleşik bir klavye içerir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Nevod вбудовано додаткову клавіатуру для набору церковнослов'янського тексту історичними літерами (ѡ, ѣ, ѕ, ѳ, ѵ та ін.), шрифтом Ponomar Unicode."
          }
        }
      }
    },
