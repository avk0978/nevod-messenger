    "Add more than one address if your node is reachable multiple ways (e.g. a home node's local network and external address)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge mehrere Adressen hinzu, wenn dein Node auf mehreren Wegen erreichbar ist (z. B. lokales Netz und externe Adresse eines Heim-Nodes)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add more than one address if your node is reachable multiple ways (e.g. a home node's local network and external address)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade más de una dirección si tu nodo es accesible de varias formas (p. ej., la red local y la dirección externa de un nodo doméstico)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez plusieurs adresses si votre nœud est joignable de plusieurs façons (par ex. réseau local et adresse externe d'un nœud domestique)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi più indirizzi se il tuo nodo è raggiungibile in più modi (ad es. rete locale e indirizzo esterno di un nodo domestico)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте больше одного адреса, если ваша нода доступна разными способами (например, локальный и внешний адрес домашней ноды)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğümünüze birden fazla yoldan erişilebiliyorsa birden fazla adres ekleyin (ör. ev düğümünün yerel ağ adresi ve harici adresi)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте більше однієї адреси, якщо ваша нода доступна різними способами (наприклад, локальна та зовнішня адреса домашньої ноди)."
          }
        }
      }
    },
