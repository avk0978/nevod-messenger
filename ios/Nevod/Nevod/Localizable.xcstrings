    "The node administrator declined your request to join." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Node-Administrator hat deine Beitrittsanfrage abgelehnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The node administrator declined your request to join."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El administrador del nodo ha rechazado tu solicitud para unirte."
          }
