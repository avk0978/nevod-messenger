    "Оба пароля должны быть заданы и отличаться друг от друга." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Passwörter müssen gesetzt und voneinander verschieden sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both passwords must be set and different from each other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas contraseñas deben estar definidas y ser distintas entre sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux mots de passe doivent être définis et différents l'un de l'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambe le password devono essere impostate e diverse tra loro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оба пароля должны быть заданы и отличаться друг от друга."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her iki parola da belirlenmeli ve birbirinden farklı olmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обидва паролі мають бути задані та відрізнятися один від одного."
