          }
        }
      }
    },
    "Messages you send to this bot are passed to %@ and processed under its terms. Your key goes to the bot encrypted, with each message, and the bot does not keep it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten an diesen Bot werden an %@ weitergegeben und nach deren Bedingungen verarbeitet. Dein Schlüssel geht verschlüsselt mit jeder Nachricht an den Bot, und der Bot speichert ihn nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages you send to this bot are passed to %@ and processed under its terms. Your key goes to the bot encrypted, with each message, and the bot does not keep it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes que envías a este bot se transmiten a %@ y se procesan según sus condiciones. Tu clave llega al bot cifrada, con cada mensaje, y el bot no la guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages que vous envoyez à ce bot sont transmis à %@ et traités selon ses conditions. Votre clé est envoyée au bot chiffrée, avec chaque message, et le bot ne la conserve pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi che invii a questo bot vengono trasmessi a %@ e trattati secondo le sue condizioni. La tua chiave arriva al bot cifrata, con ogni messaggio, e il bot non la conserva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения, которые вы отправляете этому боту, передаются компании %@ и обрабатываются по её правилам. Ваш ключ уходит боту в зашифрованном виде вместе с каждым сообщением, бот его не сохраняет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bota gönderdiğiniz mesajlar %@ şirketine iletilir ve onun koşullarına göre işlenir. Anahtarınız her mesajla birlikte şifreli olarak bota gider; bot onu saklamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомлення, які ви надсилаєте цьому боту, передаються компанії %@ і обробляються за її правилами. Ваш ключ надходить боту в зашифрованому вигляді разом із кожним повідомленням, бот його не зберігає."
          }
        }
      }
    },
