    "The AI provider rejected the key. Check it and add it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der KI-Anbieter hat den Schlüssel abgelehnt. Prüfe ihn und füge ihn erneut hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI provider rejected the key. Check it and add it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor de IA rechazó la clave. Revísala y vuelve a añadirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur d'IA a refusé la clé. Vérifiez-la et ajoutez-la de nouveau."
