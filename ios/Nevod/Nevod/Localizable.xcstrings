    "Заблокированный пользователь не сможет писать и звонить вам. Он об этом не узнает." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein blockierter Nutzer kann dir weder schreiben noch dich anrufen. Er wird nicht benachrichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A blocked user can't message or call you. They won't be notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un usuario bloqueado no puede escribirte ni llamarte. No se le notificará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un utilisateur bloqué ne peut ni vous écrire ni vous appeler. Il n'en est pas informé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un utente bloccato non può scriverti né chiamarti. Non riceverà alcuna notifica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокированный пользователь не сможет писать и звонить вам. Он об этом не узнает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engellenen kullanıcı size mesaj gönderemez ve sizi arayamaz. Bundan haberdar edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокований користувач не зможе писати й телефонувати вам. Він про це не дізнається."
          }
        }
      }
    },
