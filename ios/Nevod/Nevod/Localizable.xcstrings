    },
    "This will permanently delete your identity, contacts, and messages on this device. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden deine Identität, Kontakte und Nachrichten auf diesem Gerät dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete your identity, contacts, and messages on this device. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de forma permanente tu identidad, tus contactos y tus mensajes en este dispositivo. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre identité, vos contacts et vos messages seront définitivement supprimés de cet appareil. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua identità, i contatti e i messaggi su questo dispositivo verranno eliminati definitivamente. L'operazione non può essere annullata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это навсегда удалит вашу личность, контакты и сообщения на этом устройстве. Отменить это будет невозможно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem bu cihazdaki kimliğinizi, kişilerinizi ve mesajlarınızı kalıcı olarak siler. Geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це назавжди видалить вашу особу, контакти та повідомлення на цьому пристрої. Скасувати це буде неможливо."
          }
        }
      }
    },
