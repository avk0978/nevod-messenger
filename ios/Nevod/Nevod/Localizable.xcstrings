    "Жалоба уйдёт письмом администрации на %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Meldung wird per E-Mail an die Administration unter %@ gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your report will be emailed to the administration at %@."
